# Copy to ".env" and fill in. ".env" is git-ignored; never commit real keys.

# --- Public address (used in email links and the webhook URL) ---
PUBLIC_URL=https://your-domain.com
PORT=4000
NODE_ENV=production
TRUST_PROXY=1              # set when running behind nginx / a load balancer

# --- Razorpay (https://dashboard.razorpay.com/app/keys): rzp_test_ keys first, rzp_live_ after KYC ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=   # the secret you set when creating the webhook

# --- Email (any SMTP provider: Brevo, Amazon SES, Zoho, Mailgun, Gmail app password...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PrepPath E-books <orders@your-domain.com>"

# --- Admin ---
ADMIN_EMAIL=admin@preppath.store
ADMIN_PASSWORD=            # used only when the database is first created; change it in System > Security
SESSION_SECRET=            # long random string (required in production)

# DATA_DIR=./data          # where the database and uploads live

# --- Customer sign-in with Google (storefront only; the admin panel never uses Google) ---
# Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> "Web application".
# Add your site URL (and http://localhost:5173 / :4000 for testing) under "Authorised JavaScript origins".
GOOGLE_CLIENT_ID=
REQUIRE_LOGIN_TO_BUY=false   # true = shoppers must sign in with Google before paying (default: guest checkout allowed)
